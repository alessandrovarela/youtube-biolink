# ============================================
# Synkra AIOX Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research Tools
# --------------------------------------------

# Exa Search API (web search for agents)
# Get your key at: https://exa.ai/
EXA_API_KEY=

# Context7 (library documentation lookup)
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=

# --------------------------------------------
# Database & Backend
# --------------------------------------------

# Supabase — youtube-biolink (Next.js client-side vars)
# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API > Project API Keys > anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Reference ID do projeto development (usado pelo Supabase CLI)
SUPABASE_PROJECT_REF=your-project-ref

# Supabase (internal / AIOX tooling — não necessário para o app Next.js no MVP)
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY NÃO É USADA PELO APP NEXT.JS — e não deve ser.
#    A service role bypassa RLS em TODAS as tabelas; colocá-la no runtime do app
#    trocaria um problema de RLS por uma chave de bypass total do banco.
#    Story 6.3 (ADR-001 § 2) REFUTOU explicitamente o padrão `createAdminClient`:
#    a escrita privilegiada de tracking é feita pela RPC `record_link_click`
#    (SECURITY DEFINER, 1 operação, auditável), com a anon key de sempre.
#    Consequência: o PRE-3 do Epic 6 (provisionar a service role em prod/preview)
#    está CANCELADO.
#    Uso legítimo desta chave: tooling AIOX e setup/teardown dos testes de
#    integração (tests/integration/helpers/admin.ts) — nunca em lib/ ou app/.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Rate limiting (Story 6.4 — FR21 / NFR18 / NFR19)
# --------------------------------------------
#
# RATE_LIMIT_PEPPER — string aleatória usada como "pepper" no SHA-256 que deriva a
# identidade do chamador a partir do IP. O IP é usado APENAS EM MEMÓRIA e nunca é
# gravado, logado ou enviado ao banco (NFR19); só o digest hex de 64 chars sai do
# processo. O pepper existe porque o espaço IPv4 tem 2^32 endereços — um SHA-256 sem
# segredo seria reversível por força bruta.
#
# ⚠️ SERVER-ONLY. NUNCA prefixar com NEXT_PUBLIC_ — isso a mandaria para o bundle do
#    browser e anularia inteiramente o propósito.
#
# NÃO É UMA CREDENCIAL PRIVILEGIADA (contraste didático com SUPABASE_SERVICE_ROLE_KEY
# acima): o vazamento deste valor permite CORRELACIONAR hashes de IP e nada mais — não
# dá acesso a recurso nenhum. O vazamento da service role key entregaria o banco inteiro.
#
# Se ausente: o app NÃO quebra e o rate limiting CONTINUA ATIVO — o hash é calculado com
# pepper vazio. O servidor emite UM aviso no log (lib/rate-limit.ts) para que a ausência
# não passe silenciosa.
#
# Gerar: openssl rand -hex 32
# ⚠️ GATE DE MERGE: @devops (exclusivo) deve provisionar em production E preview na
#    Vercel ANTES do merge da Story 6.4.
RATE_LIMIT_PEPPER=

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --------------------------------------------
# Project Management
# --------------------------------------------

# ClickUp API (if using ClickUp integration)
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=

# --------------------------------------------
# Automation & Workflows
# --------------------------------------------

# N8N (workflow automation)
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring & Analytics
# --------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=

# --------------------------------------------
# Cloud Providers
# --------------------------------------------

# Railway (deployment)
RAILWAY_TOKEN=

# Vercel (deployment)
VERCEL_TOKEN=

# --------------------------------------------
# AIOX Core Configuration
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=2.2.0

# --------------------------------------------
# Custom Configuration
# --------------------------------------------
# Add your custom API keys below
